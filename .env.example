# ─── Bookuj Deployment Configuration ──────────────────────────────────────
#
# NEXT_PUBLIC_FEATURED_SLUG
# The slug of the property shown at the root URL (/).
# Set this on each real host Vercel project to their property slug.
# Example: NEXT_PUBLIC_FEATURED_SLUG=zakopane-gorna-chata
# Leave empty on the internal demo deployment.
#
NEXT_PUBLIC_FEATURED_SLUG=

# NEXT_PUBLIC_SHOW_DEMO_SWITCHER
# Set to "true" ONLY on the internal demo/sales Vercel project.
# When unset (or any other value) the DemoPropertySwitcher is invisible to guests.
#
NEXT_PUBLIC_SHOW_DEMO_SWITCHER=

# ─── Supabase Configuration ────────────────────────────────────────────────
#
# NEXT_PUBLIC_SUPABASE_URL / SUPABASE_URL
# Supabase project URL (e.g. https://xyzcompany.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# NEXT_PUBLIC_SUPABASE_ANON_KEY / SUPABASE_ANON_KEY
# Supabase public anonymous API key
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SUPABASE_SERVICE_ROLE_KEY
# Used by one-off seed script (scripts/seed-properties.mjs)
SUPABASE_SERVICE_ROLE_KEY=

# NEXT_PUBLIC_USE_LOCAL_DATA
# Set to "true" to force local sample-properties.json data fallback during development
NEXT_PUBLIC_USE_LOCAL_DATA=false
